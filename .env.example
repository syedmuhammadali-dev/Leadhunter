# Database (Neon free Postgres, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web (public, non-secret only)
NEXT_PUBLIC_API_URL=http://localhost:4000

# n8n <-> API (generate long random values, e.g. `openssl rand -hex 32`)
N8N_WEBHOOK_SECRET=change-me
INTERNAL_API_KEY=change-me

# Non-pooled URL for Prisma migrations (Neon: same URL without -pooler in the host)
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
