# Database (Neon free Postgres, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web (public, non-secret only)
NEXT_PUBLIC_API_URL=http://localhost:4000

# n8n <-> API (generate long random values, e.g. `openssl rand -hex 32`)
N8N_WEBHOOK_SECRET=change-me
INTERNAL_API_KEY=change-me

# Non-pooled URL for Prisma migrations (Neon: same URL without -pooler in the host)
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Website audits (Phase 5)
AUDIT_CONCURRENCY=2
AUDIT_HOST_DELAY_MS=1500
# Optional Google PageSpeed performance score (free API; key optional)
PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=

# Optional: JSON file overriding scoring weights/thresholds (see docs/scoring.md)
# SCORING_CONFIG_PATH=

# n8n webhook that starts a research job (the API calls it; N8N_WEBHOOK_SECRET must match the one n8n runs with)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-research
# Max website audits per research job
JOB_MAX_AUDITS=25
