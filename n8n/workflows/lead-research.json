    {
      "parameters": {
        "jsCode": "// Step 1: validate the input before anything is created.\nconst body = $input.first().json.body || {};\nconst errors = [];\nfor (const key of ['country', 'city', 'category']) {\n  const value = body[key];\n  if (typeof value !== 'string' || value.trim().length === 0 || value.trim().length > 100) {\n    errors.push(key + ' is required (max 100 characters)');\n  }\n}\nconst limit = Number(body.limit);\nif (!Number.isInteger(limit) || limit < 1 || limit > 500) {\n  errors.push('limit must be a whole number from 1 to 500');\n}\nconst provider = body.provider === undefined ? 'mock' : body.provider;\nif (provider !== 'mock') {\n  errors.push('provider must be \"mock\"');\n}\nconst input = errors.length > 0 ? null : {\n  country: body.country.trim(),\n  city: body.city.trim(),\n  category: body.category.trim(),\n  limit,\n  provider,\n};\nreturn [{ json: { ok: errors.length === 0, errors, input } }];"
      },
      "id": "a0000000-0000-4000-8000-000000000005",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
